{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onelystop.local/banking/feature_tables/papers.schema.json",
  "title": "papers",
  "description": "One row per exam paper. Content table for Question Bank / PYQ Mix / Past Papers.",
  "type": "object",
  "required": ["paper_id", "exam_key", "is_canonical", "is_active"],
  "properties": {
    "paper_id": { "type": "string", "description": "Which document this is. Everything hangs off it." },
    "bank": { "type": ["string", "null"], "description": "SBI, IBPS, …" },
    "role": { "type": ["string", "null"], "description": "PO, Clerk, RRB, …" },
    "exam_type": { "type": ["string", "null"], "description": "Prelims or Mains" },
    "year": { "type": ["integer", "null"] },
    "shift": { "type": ["string", "null"], "description": "Morning / afternoon sitting" },
    "memory_based": { "type": ["boolean", "null"] },
    "exam_key": {
      "type": "string",
      "description": "bank + role + exam_type + year + shift; papers sharing a key describe the same real exam."
    },
    "is_canonical": {
      "type": "boolean",
      "description": "Show this one; hide other recalls of the same exam_key."
    },
    "duration_min": { "type": ["integer", "null"], "description": "Exam duration in minutes (from exam pattern)." },
    "total_marks": { "type": ["number", "null"], "description": "Marks for the whole paper (from exam pattern)." },
    "section_timing": {
      "type": ["array", "null"],
      "description": "Prelims sectional timing, if any.",
      "items": {
        "type": "object",
        "required": ["section", "duration_min"],
        "properties": {
          "section": { "type": "string" },
          "duration_min": { "type": "integer" },
          "questions": { "type": ["integer", "null"] },
          "marks": { "type": ["number", "null"] }
        }
      }
    },
    "source_pdf": { "type": ["string", "null"], "description": "PDF path for tracing mistakes." },
    "is_active": { "type": "boolean", "description": "Hide a bad paper without deleting it." },
    "question_count": { "type": ["integer", "null"] },
    "language": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
