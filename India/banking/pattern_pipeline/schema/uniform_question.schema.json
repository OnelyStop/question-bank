{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onelystop.local/banking/uniform_question.schema.json",
  "title": "UniformBankingQuestion",
  "description": "Supabase-ready flat question row produced by the pattern extraction pipeline.",
  "type": "object",
  "required": [
    "q_id",
    "paper_id",
    "question_pattern",
    "stem",
    "options",
    "option_count",
    "has_shared_directions",
    "is_bilingual",
    "has_image",
    "source_collection"
  ],
  "properties": {
    "q_id": { "type": "string" },
    "paper_id": { "type": "string" },
    "bank": { "type": ["string", "null"] },
    "role": { "type": ["string", "null"] },
    "exam_type": { "type": ["string", "null"] },
    "year": { "type": ["integer", "null"] },
    "shift": { "type": ["string", "null"] },
    "memory_based": { "type": ["boolean", "null"] },
    "language": { "type": ["string", "null"] },
    "section": { "type": ["string", "null"] },
    "subject": { "type": ["string", "null"] },
    "topic": { "type": ["string", "null"] },
    "q_num": { "type": ["integer", "null"] },
    "question_pattern": {
      "type": "string",
      "enum": [
        "standalone_mcq",
        "shared_directions_set",
        "reading_comprehension_set",
        "cloze_passage_set",
        "image_figure_based",
        "visual_chart_graph_di",
        "table_di_set",
        "caselet_di_set",
        "data_sufficiency",
        "quantity_comparison",
        "quadratic_comparison",
        "match_the_columns",
        "partial_or_missing_options",
        "bilingual_stem_directions"
      ]
    },
    "secondary_patterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "direction_id": { "type": ["string", "null"] },
    "direction_text": { "type": ["string", "null"] },
    "stem": { "type": "string" },
    "options": {
      "type": "object",
      "propertyNames": { "enum": ["a", "b", "c", "d", "e"] },
      "additionalProperties": { "type": "string" }
    },
    "option_count": { "type": "integer", "minimum": 0, "maximum": 5 },
    "answer": { "type": ["string", "null"], "enum": ["a", "b", "c", "d", "e", null] },
    "explanation": { "type": ["string", "null"] },
    "has_shared_directions": { "type": "boolean" },
    "is_bilingual": { "type": "boolean" },
    "has_image": { "type": "boolean" },
    "image_refs": {
      "type": "array",
      "items": { "type": "object" }
    },
    "source_pdf_path": { "type": ["string", "null"] },
    "source_collection": {
      "type": "string",
      "enum": ["papers", "papers-deduped", "mixed", "unknown"]
    },
    "classification_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "classification_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "page_start": { "type": ["integer", "null"] },
    "page_end": { "type": ["integer", "null"] },
    "raw_metrics": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
