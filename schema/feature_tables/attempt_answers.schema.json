{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onelystop.local/banking/feature_tables/attempt_answers.schema.json",
  "title": "attempt_answers",
  "description": "One row per question answered in a sitting. Powers mastery / progress / grade rail.",
  "type": "object",
  "required": ["attempt_id", "q_id"],
  "properties": {
    "attempt_id": { "type": "string" },
    "q_id": { "type": "string" },
    "chosen": { "type": ["string", "null"], "enum": ["a", "b", "c", "d", "e", null], "description": "Empty if skipped." },
    "is_correct": { "type": ["boolean", "null"] },
    "time_ms": { "type": ["integer", "null"], "description": "How long they took." }
  },
  "additionalProperties": false
}
