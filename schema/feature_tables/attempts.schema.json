{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onelystop.local/banking/feature_tables/attempts.schema.json",
  "title": "attempts",
  "description": "One row each time a student sits something. Runtime table — empty until product use.",
  "type": "object",
  "required": ["attempt_id", "user_id", "mode", "started_at"],
  "properties": {
    "attempt_id": { "type": "string", "description": "This sitting." },
    "user_id": { "type": "string", "description": "Who." },
    "mode": { "type": "string", "enum": ["bank", "mix", "paper"], "description": "bank, mix or paper." },
    "paper_id": { "type": ["string", "null"], "description": "Set only for a full paper." },
    "started_at": { "type": "string", "format": "date-time" },
    "submitted_at": { "type": ["string", "null"], "format": "date-time", "description": "Empty until they finish (resume)." },
    "score": { "type": ["number", "null"], "description": "Final marks after negatives." }
  },
  "additionalProperties": false
}
