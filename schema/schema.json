{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OnelyStop/question-bank/schema/schema.json",
  "title": "OnelyStop question",
  "description": "One exported question, flat. Everything needed to filter it (bank, role, year, shift, section, pattern) and to render it (stem, options, inlined direction_text) is on the row. x-fill is the percentage non-null across all 18,651 questions.",
  "type": "object",
  "required": [
    "q_id",
    "paper_id",
    "q_num",
    "content_hash",
    "memory_based",
    "language",
    "question_pattern",
    "has_image",
    "marks",
    "negative_marks",
    "option_count",
    "is_active"
  ],
  "properties": {
    "q_id": {
      "type": "string",
      "description": "Parser. Unique question id.",
      "x-fill": 100.0
    },
    "paper_id": {
      "type": "string",
      "description": "Which paper it came from. Never drop this.",
      "x-fill": 100.0
    },
    "q_num": {
      "type": "integer",
      "description": "Parser. Number in that paper; sets mock order.",
      "x-fill": 100.0
    },
    "content_hash": {
      "type": "string",
      "description": "Import. Fingerprint of stem + options for dedupe.",
      "x-fill": 100.0
    },
    "stem": {
      "type": "string",
      "description": "Parser. The question text.",
      "x-fill": 99.1
    },
    "options": {
      "type": "object",
      "description": "Parser. Choices a–e.",
      "propertyNames": {
        "enum": [
          "a",
          "b",
          "c",
          "d",
          "e"
        ]
      },
      "additionalProperties": {
        "type": "string"
      },
      "x-fill": 97.8
    },
    "answer": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "a",
        "b",
        "c",
        "d",
        "e",
        null
      ],
      "description": "Parser. Correct option when known.",
      "x-fill": 0.0
    },
    "explanation": {
      "type": [
        "string",
        "null"
      ],
      "description": "Parser. Why the answer is right.",
      "x-fill": 0.0
    },
    "direction_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Parser. Shared passage id within the paper, if any.",
      "x-fill": 71.3
    },
    "direction_text": {
      "type": [
        "string",
        "null"
      ],
      "description": "The shared passage / DI table / seating arrangement, inlined. 71% of questions have one.",
      "x-fill": 71.3
    },
    "bank": {
      "type": [
        "string",
        "null"
      ],
      "description": "Copied from the paper so questions filter without a join.",
      "x-fill": 92.2
    },
    "role": {
      "type": [
        "string",
        "null"
      ],
      "description": "Copied from the paper so questions filter without a join.",
      "x-fill": 97.3
    },
    "exam_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Copied from the paper so questions filter without a join.",
      "x-fill": 92.6
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Copied from the paper so questions filter without a join.",
      "x-fill": 96.1
    },
    "shift": {
      "type": [
        "string",
        "null"
      ],
      "description": "Copied from the paper so questions filter without a join.",
      "x-fill": 19.8
    },
    "memory_based": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Copied from the paper so questions filter without a join.",
      "x-fill": 100.0
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "description": "Copied from the paper so questions filter without a join.",
      "x-fill": 100.0
    },
    "section": {
      "type": [
        "string",
        "null"
      ],
      "description": "Classifier. Reasoning / Quantitative / English / GA / …",
      "x-fill": 17.3
    },
    "topic": {
      "type": [
        "string",
        "null"
      ],
      "description": "Classifier. Finer label than section.",
      "x-fill": 0.0
    },
    "topic_source": {
      "type": [
        "string",
        "null"
      ],
      "description": "Classifier. How topic was assigned (rules / llm / manual / …).",
      "x-fill": 0.0
    },
    "difficulty": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5,
      "description": "Classifier. Difficulty 1–5.",
      "x-fill": 0.0
    },
    "question_pattern": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional structural pattern from pattern pipeline.",
      "enum": [
        "standalone_mcq",
        "shared_directions_set",
        "reading_comprehension_set",
        "cloze_passage_set",
        "image_figure_based",
        "visual_chart_graph_di",
        "table_di_set",
        "caselet_di_set",
        "data_sufficiency",
        "quantity_comparison",
        "quadratic_comparison",
        "match_the_columns",
        "partial_or_missing_options",
        "bilingual_stem_directions"
      ],
      "x-fill": 100.0
    },
    "has_image": {
      "type": "boolean",
      "description": "Parser. Whether the question depends on a figure/chart image.",
      "x-fill": 100.0
    },
    "image_refs": {
      "type": "array",
      "description": "Parser. Image/figure references for this question.",
      "items": {
        "type": "object"
      },
      "x-fill": 0.0
    },
    "page_start": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Parser. First PDF page for this question (1-based).",
      "x-fill": 87.2
    },
    "marks": {
      "type": [
        "number",
        "null"
      ],
      "description": "Import. Usually 1, from exam pattern.",
      "x-fill": 100.0
    },
    "negative_marks": {
      "type": [
        "number",
        "null"
      ],
      "description": "Import. Usually 0.25, from exam pattern.",
      "x-fill": 100.0
    },
    "option_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Import. Number of options present.",
      "x-fill": 100.0
    },
    "is_active": {
      "type": "boolean",
      "description": "Import. false if options missing/empty.",
      "x-fill": 100.0
    }
  },
  "additionalProperties": false
}
